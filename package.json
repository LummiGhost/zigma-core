{
  "name": "@zigma-ai/zigma-core",
  "version": "0.1.2",
  "description": "Zigma platform control plane for projects, tasks, permissions, approvals, and evidence.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LummiGhost/zigma-core.git"
  },
  "type": "module",
  "bin": {
    "zigma-core": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:readiness": "node tests/run-readiness.mjs",
    "test:m0-cross-repo": "node tests/run-m0-cross-repo-contracts.mjs",
    "test:m3-cross-repo": "node tests/run-m3-cross-repo-contracts.mjs",
    "test:m4-cross-repo": "node tests/run-m4-cross-repo-contracts.mjs",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fastify": "^5.4.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
